@model WebNgheNhac.Models.Playlist
@{
    ViewData["Title"] = Model.Name;
}

<div class="app-container">
    <aside class="sidebar">
        <div class="logo">
            <i class="fas fa-music"></i>
            <span>WebNgheNhac</span>
        </div>
        <nav class="menu">
            <a href="/" class="menu-item"><i class="fas fa-home"></i> Trang chủ</a>
            <a href="/Playlist" class="menu-item active"><i class="fas fa-book"></i> Playlist</a>
        </nav>
    </aside>

    <main class="main-content">
        <header class="top-bar">
            <div class="nav-buttons">
                <button onclick="history.back()"><i class="fas fa-chevron-left"></i></button>
            </div>
        </header>

        <section class="playlist-detail-header">
            <h1>@Model.Name</h1>
            <p>@Model.Description</p>
        </section>

        <section class="playlist-detail-embed">
            <iframe 
                style="border-radius:12px" 
                src="https://open.spotify.com/embed/playlist/@Model.SpotifyPlaylistId?utm_source=generator" 
                width="100%" 
                height="500" 
                frameborder="0" 
                allowfullscreen="" 
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" 
                loading="lazy">
            </iframe>
        </section>
    </main>
</div>
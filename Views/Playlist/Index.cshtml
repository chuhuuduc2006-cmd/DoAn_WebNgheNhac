@model List<WebNgheNhac.Models.Playlist>
@{
    ViewData["Title"] = "Playlist";
}

<div class="app-container">
    <aside class="sidebar">
        <div class="logo">
            <i class="fas fa-music"></i>
            <span>WebNgheNhac</span>
        </div>
        <nav class="menu">
            <a href="/" class="menu-item"><i class="fas fa-home"></i> Trang chủ</a>
            <a href="/Playlist" class="menu-item active"><i class="fas fa-book"></i> Playlist</a>
            <a href="/Search" class="menu-item"><i class="fas fa-search"></i> Tìm kiếm</a>
        </nav>
    </aside>

    <main class="main-content">
        <header class="top-bar">
            <div class="nav-buttons">
                <button onclick="history.back()"><i class="fas fa-chevron-left"></i></button>
            </div>
            <div class="user-area">
                @if (Context.Session.GetString("Username") != null)
                {
                    <span class="greeting">Chào, <strong>@Context.Session.GetString("Username")</strong></span>
                    <a href="/Account/Logout" class="btn-logout">Đăng xuất</a>
                }
            </div>
        </header>

        <section class="greeting-banner">
            <h1>Playlist của tôi 🎧</h1>
            <p>Những bản nhạc tuyển chọn dành cho bạn</p>
        </section>

        <div class="playlists-grid">
            @foreach (var pl in Model)
            {
                <a href="/Playlist/Detail/@pl.Id" class="playlist-card">
                    <div class="playlist-card-image">
                        <i class="fas fa-music"></i>
                    </div>
                    <h3>@pl.Name</h3>
                    <p>@pl.Description</p>
                </a>
            }
        </div>
    </main>
</div>
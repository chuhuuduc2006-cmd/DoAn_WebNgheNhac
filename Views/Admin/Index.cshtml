@model List<WebNgheNhac.Models.Song>
@{
    ViewData["Title"] = "Quản lý bài hát";
}

<div class="app-container">
    <!-- Sidebar Admin -->
    <aside class="sidebar">
        <div class="logo"><i class="fas fa-user-shield"></i><span>Admin Panel</span></div>
        <nav class="menu">
            <a href="/Admin" class="menu-item active"><i class="fas fa-music"></i> Quản lý nhạc</a>
            <a href="/" class="menu-item"><i class="fas fa-home"></i> Về trang chủ</a>
        </nav>
    </aside>

    <main class="main-content">
        <header class="top-bar">
            <h1 style="font-size: 24px;">Danh sách bài hát</h1>
            <a href="/Admin/Create" class="btn-signup" style="text-decoration: none; padding: 10px 20px;">
                <i class="fas fa-plus"></i> Thêm bài hát mới
            </a>
        </header>

        <div class="admin-table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tên bài hát</th>
                        <th>Ca sĩ</th>
                        <th>File (đường dẫn)</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var song in Model)
                    {
                        <tr>
                            <td>@song.Id</td>
                            <td style="font-weight: 600;">@song.Title</td>
                            <td style="color: #b3b3b3;">@song.Artist</td>
                            <td style="font-size: 12px; color: #1DB954;">@song.FilePath</td>
                            <td>
                                <a href="/Admin/Edit/@song.Id" class="btn-edit"><i class="fas fa-edit"></i> Sửa</a>
                                <a href="/Admin/Delete/@song.Id" class="btn-delete" onclick="return confirm('Bạn có chắc chắn muốn xóa bài hát này?')"><i class="fas fa-trash"></i> Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>
</div>
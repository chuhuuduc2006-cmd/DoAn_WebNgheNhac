@model List<WebNgheNhac.Models.Song>
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="app-container">
    <aside class="sidebar">
        <div class="logo">
            <i class="fas fa-music"></i>
            <span>WebNgheNhac</span>
        </div>

        <nav class="menu">
            <a href="/" class="menu-item active"><i class="fas fa-home"></i> Trang chủ</a>
            <a href="/Playlist" class="menu-item"><i class="fas fa-book"></i> Playlist</a>
            <a href="/Search" class="menu-item"><i class="fas fa-search"></i> Tìm kiếm</a>
            <a href="/Admin" class="menu-item" style="color: #ffeb3b;"><i class="fas fa-user-shield"></i> Trang Admin</a>
        </nav>

        <div class="playlist-section">
            <h4>PLAYLIST</h4>
            <a href="/Playlist/Detail/1" class="playlist-item">🎵 Playlist của tôi</a>
            <a href="/Playlist/Detail/2" class="playlist-item">🔥 Nhạc Chill</a>
            <a href="/Playlist/Detail/3" class="playlist-item">💚 Rap Việt Hot</a>
        </div>
    </aside>

    <main class="main-content">
        <header class="top-bar">
            <div class="nav-buttons">
                <button><i class="fas fa-chevron-left"></i></button>
                <button><i class="fas fa-chevron-right"></i></button>
            </div>
            <div class="user-area">
                @if (Context.Session.GetString("Username") != null)
                {
                    <span class="greeting">Chào, <strong>@Context.Session.GetString("Username")</strong></span>
                    <a href="/Account/Logout" class="btn-logout">Đăng xuất</a>
                }
                else
                {
                    <a href="/Account/Login" class="btn-login">Đăng nhập</a>
                    <a href="/Account/Register" class="btn-signup">Đăng ký</a>
                }
            </div>
        </header>

        <section class="greeting-banner">
            <h1>Chào buổi tối 👋</h1>
            <p>Hôm nay bạn muốn nghe gì?</p>
        </section>

        <section class="songs-section">
            <div class="section-header">
                <h2>Bài hát nổi bật</h2>
            </div>

            <div class="songs-grid">
                @foreach (var song in Model)
                {
                    <div class="song-card">
                        <div class="card-image">
                            <img src="/uploads/@(song.ImagePath ?? "default.jpg")" alt="@song.Title" />
                            <button class="play-overlay"
                                    onclick="playSong('@song.FilePath', '@song.Title', '@song.Artist', '@(song.ImagePath ?? "default.jpg")')">
                                <i class="fas fa-play"></i>
                            </button>
                        </div>
                        <div class="card-info">
                            <h3 class="card-title">@song.Title</h3>
                            <p class="card-artist">@song.Artist</p>
                        </div>
                    </div>
                }
            </div>
        </section>
    </main>
</div>

<!-- PLAYER BAR -->
<div class="player-bar">
    <div class="player-left">
        <img id="player-img" src="/uploads/default.jpg" alt="cover" />
        <div class="player-info">
            <div id="player-title" class="player-title">Chưa chọn bài</div>
            <div id="player-artist" class="player-artist">—</div>
        </div>
    </div>

    <div class="player-center">
        <div class="player-controls">
            <button><i class="fas fa-random"></i></button>
            <button><i class="fas fa-step-backward"></i></button>
            <button id="main-play-btn" class="main-play"><i class="fas fa-play"></i></button>
            <button><i class="fas fa-step-forward"></i></button>
            <button><i class="fas fa-redo"></i></button>
        </div>
        <div class="player-progress">
            <span id="current-time">0:00</span>
            <input type="range" id="progress-bar" min="0" max="100" value="0" />
            <span id="duration">0:00</span>
        </div>
    </div>

    <div class="player-right">
        <i class="fas fa-volume-down"></i>
        <input type="range" id="volume-bar" min="0" max="100" value="80" />
    </div>

    <audio id="audio-player"></audio>
</div>
